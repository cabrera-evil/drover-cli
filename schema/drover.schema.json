          "stop": {
            "description": "Shell command used to stop the process.",
            "type": "string"
          },
          "tags": {
            "description": "Tags used by groups and presets.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "use": {
            "description": "Template to start from; process keys win over template keys.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "description": "Processes to supervise, keyed by name.",
      "type": "object"
    },
