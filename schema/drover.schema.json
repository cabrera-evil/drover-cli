                "type": "string"
              },
              "timeout": {
                "description": "Go duration, e.g. 500ms, 5s, 2m.",
                "type": "string"
              }
            },
            "type": "object"
          },
          "restart": {
            "description": "never, on-failure, or {on-failure: {max: N}}.",
            "oneOf": [
              {
                "enum": [
                  "never",
